# BlotterCast Database & Service Environment Configuration
# Supported Database Providers: PlanetScale, TiDB Cloud, Aiven for MySQL, Railway MySQL

DB_HOST=your-mysql-host.com
DB_PORT=3306
DB_USER=root
DB_PASS=your-password
DB_NAME=blottercast
DB_SSL=true

# Alternative: Single Connection String (Vercel Storage auto-injects DATABASE_URL or MYSQL_URL)
# DATABASE_URL=mysql://user:password@host:3306/blottercast?ssl=true

# Python ML Microservice URL (Deployed on Render / Railway / HuggingFace)
ML_SERVICE_URL=http://localhost:5000
